# ==========================================================================
# AI4I 5W1H KU experiment — LLM API configuration
# ==========================================================================
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# All LLM-dependent phases (B3-B8 generation, Layer 2/3, cross-LLM) read from
# here via src/llm_config.py. Leave a provider's API_KEY empty to disable it.
#
# --------------------------------------------------------------------------

# ---- Primary model (OpenAI-compatible; e.g. GLM via Zhipu BigModel) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash

# ---- Cross-LLM model (e.g. DeepSeek official API) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Generation defaults (paper §4.2.3 fairness protocol) ----
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---- Optional: RAG embedding model (B6/B7, deferred) ----
# Empty => RAG is skipped. Set to a text-embedding model name to enable.
EMBEDDING_MODEL=text-embedding-ada-002

# ---- Third judge (GLM-5.3, Zhipu AI) ----
GLM53_API_KEY=
GLM53_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM53_MODEL=glm-5.3

# ---- Fourth judge (Kimi k2.6, Moonshot family; disjoint from GLM + DeepSeek) ----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.siliconflow.cn/v1
KIMI_MODEL=Pro/moonshotai/Kimi-K2.6
