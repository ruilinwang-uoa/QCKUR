@echo off
REM ============================================================
REM GLM-5.3 third-judge re-evaluation of the cross-LLM table
REM   - Input : runs/reports_crossllm_deepseek_n100_B1B8_glm53.parquet
REM             (800 reports, all generated by DeepSeek-V4-Flash)
REM   - Judge : GLM-5.3 via BigModel coding endpoint (third family,
REM             disjoint from the DeepSeek generator)
REM   - Budget: max_tokens 3000 (GLM-5.3 is a reasoning judge and uses
REM             the enlarged judging budget reported in paper Section 4.2.3)
REM   - Output: runs/..._glm53_l2.parquet / ..._glm53_l3.parquet
REM   - Resume: both scripts skip already-scored (method, instance) pairs
REM             and checkpoint every 10 reports, so this .bat can be
REM             safely re-run after any interruption.
REM   - ETA   : ~4 workers -> L2 ~3 h + L3 ~2.5 h (validated 2026-08-28:
REM             8 reports / 4 workers / 126 s wall, zero rate-limit errors)
REM ============================================================

set PY=python
cd /d "%~dp0src"

echo === GLM-5.3 L2 judging started %date% %time% ===
%PY% layer2_eval.py reports_crossllm_deepseek_n100_B1B8_glm53.parquet --judge glm53 --seed 42 --max-tokens 3000 --workers 4 > ..\logs\glm53_l2.log 2>&1
echo === GLM-5.3 L2 judging finished %date% %time% (see logs\glm53_l2.log) ===

echo === GLM-5.3 L3 judging started %date% %time% ===
%PY% layer3_eval.py reports_crossllm_deepseek_n100_B1B8_glm53.parquet --judge glm53 --seed 42 --max-tokens 3000 --workers 4 > ..\logs\glm53_l3.log 2>&1
echo === GLM-5.3 L3 judging finished %date% %time% (see logs\glm53_l3.log) ===

echo === ALL DONE %date% %time% ===
pause
