@echo off
REM ============================================================
REM Kimi K2.6 fourth-judge re-evaluation of the PRIMARY table
REM   - Input : runs/reports_main_glm_n100_kimi.parquet
REM             (800 canonical reports, all generated by GLM-4-Flash;
REM              a renamed copy of reports_main_glm_n100.parquet)
REM   - Judge : Kimi K2.6 (Pro/moonshotai/Kimi-K2.6) via SiliconFlow --
REM             Moonshot family, disjoint from BOTH the GLM generator and
REM             the DeepSeek primary judge (paper Section 5.3 judge battery)
REM   - Budget: max_tokens 1500, temperature 0.3, seed 42 -- matching the
REM             primary DeepSeek judging passes. Kimi runs in NON-thinking
REM             mode (enable_thinking=false via llm_config extra_body),
REM             which is why the primary budget suffices: no chain-of-thought
REM             competes with the strict-JSON output.
REM   - Output: runs/reports_main_glm_n100_kimi_l2.parquet / _l3.parquet
REM   - Resume: both scripts skip already-scored (method, instance)
REM             pairs and checkpoint every 10 reports, so this .bat can
REM             be safely re-run after any interruption.
REM   - ETA   : non-thinking calls take ~1-3 s; ~10-30 min per layer at
REM             4 workers.
REM
REM BEFORE RUNNING: set KIMI_API_KEY in the experiment-root .env file
REM ============================================================

set PY=python
cd /d "%~dp0src"

echo === Step 0: configuration check %date% %time% ===
%PY% llm_config.py | findstr /C:"kimi" /C:"env_file_exists"
echo (If kimi shows "configured": false, edit the experiment-root .env file first.)

echo === Step 1: SMOKE TEST (3 reports per system, L3 only) %date% %time% ===
%PY% layer3_eval.py reports_main_glm_n100_kimi.parquet --judge kimi --seed 42 --max-tokens 1500 --n 3 --workers 2 > ..\logs\kimi_smoke.log 2>&1
%PY% -c "import pandas as pd; d=pd.read_parquet('../runs/reports_main_glm_n100_kimi_l3.parquet'); print(d.groupby('method')['ok'].agg(['sum','count']).to_string()); import sys; sys.exit(0 if d['ok'].all() else 1)" || (echo SMOKE TEST FAILED -- check logs\kimi_smoke.log before continuing & pause & exit /b 1)
echo Smoke test passed. The smoke-scored reports are kept and skipped in the full run.

echo === Step 2: full Kimi L2 judging started %date% %time% ===
%PY% layer2_eval.py reports_main_glm_n100_kimi.parquet --judge kimi --seed 42 --max-tokens 1500 --workers 4 > ..\logs\kimi_l2.log 2>&1
echo === Step 2: Kimi L2 judging finished %date% %time% (see logs\kimi_l2.log) ===

echo === Step 3: full Kimi L3 judging started %date% %time% ===
%PY% layer3_eval.py reports_main_glm_n100_kimi.parquet --judge kimi --seed 42 --max-tokens 1500 --workers 4 > ..\logs\kimi_l3.log 2>&1
echo === Step 3: Kimi L3 judging finished %date% %time% (see logs\kimi_l3.log) ===

echo === Step 4: agreement analysis %date% %time% ===
%PY% analyze_kimi_judge.py > ..\logs\kimi_analysis.log 2>&1
type ..\logs\kimi_analysis.log

echo === ALL DONE %date% %time% ===
pause
