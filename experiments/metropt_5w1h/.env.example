# ==========================================================================
# MetroPT 5W1H experiment — LLM API configuration
# ==========================================================================
# Copy this file to `.env` and fill in your values. `.env` should remain
# git-ignored. LLM-dependent generation and judging scripts read settings
# from this file via src/llm_config.py. Leave a provider API key empty to
# disable that provider.
#
# The model identifiers below match the model families reported in the
# manuscript. If a provider changes an API-side identifier, record the exact
# identifier and access date used for any new run.
# --------------------------------------------------------------------------

# ---- Primary generation model: GLM-4-Flash via Zhipu BigModel ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash

# ---- Primary judge / cross-LLM model: DeepSeek-V4-Flash ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Third judge: GLM-5.3 via Zhipu BigModel ----
GLM53_API_KEY=
GLM53_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM53_MODEL=glm-5.3

# ---- Fourth judge: Kimi K2.6 via SiliconFlow, non-thinking mode ----
KIMI_API_KEY=
KIMI_BASE_URL=https://api.siliconflow.cn/v1
KIMI_MODEL=Pro/moonshotai/Kimi-K2.6

# ---- Shared generation defaults ----
# Individual scripts may override max_tokens for specific campaigns/judging
# passes (for example the larger MetroPT Layer-2/Layer-3 judging budgets).
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---- Optional RAG embedding model (B6/B7 where applicable) ----
# Empty => embedding-based retrieval is disabled.
EMBEDDING_MODEL=text-embedding-ada-002
